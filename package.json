{
    "name": "appium-locators-inspector",
    "version": "1.2.1",
    "private": true,
    "description": "Chrome extension for identifying locators in Android/iOS apps using Appium",
    "type": "module",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsx scripts/build.ts",
        "package:extension": "npm run build && tsx scripts/package-extension.ts",
        "backend": "npm run build && node dist/npm/backend/server.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "companion": "npm run build && node dist/npm/cli.js",
        "publish:companion": "npm run build && npm publish ./dist/npm --access public"
    },
    "dependencies": {
        "express": "^4.21.2",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@types/chrome": "^0.1.0",
        "@types/express": "^4.17.21",
        "@types/jsdom": "^21.1.7",
        "@types/node": "^22.10.0",
        "@types/ws": "^8.5.13",
        "@vitest/coverage-v8": "^3.2.7",
        "esbuild": "^0.28.2",
        "jsdom": "^26.0.0",
        "tsx": "^4.23.15",
        "typescript": "^5.9.0",
        "vitest": "^3.2.0"
    },
    "keywords": [
        "appium",
        "mobile",
        "testing",
        "chrome-extension",
        "locator"
    ],
    "author": "Julian Wang",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JulianWangHZ/Appium-Locators-Inspector.git"
    },
    "homepage": "https://github.com/JulianWangHZ/Appium-Locators-Inspector#readme"
}
