{
    "manifest_version": 3,
    "name": "Appium Locators Inspector",
    "version": "1.2.1",
    "description": "Inspect Android & iOS apps via Appium: live UI tree, ranked locators, and record actions into runnable Java/Python/TS tests.",
    "permissions": [
        "storage",
        "nativeMessaging"
    ],
    "host_permissions": [
        "http://localhost/*"
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js"
    }
}
